<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_danmaku_setting_panel"
    android:orientation="vertical">

    <!-- 标题 + 弹幕总开关：参照 NewBox 的 panel_danmaku_control，开关放在标题行右侧 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/danmaku_setting"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reset"
            android:layout_width="86dp"
            android:layout_height="40dp"
            android:background="@drawable/selector_control_sheet_button"
            android:gravity="center"
            android:text="@string/danmaku_reset"
            android:textColor="@color/selector_control_sheet_text"
            android:textSize="14sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 来源区：来源管理 / 在线搜索 / 自动匹配 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/shape_danmaku_card"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/sourceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_danmaku_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/danmaku_source"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/sourceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/white_50"
                    android:textSize="11sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/danmaku_source_test"
                android:textColor="@color/white_70"
                android:textSize="12sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="#14FFFFFF" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/searchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_danmaku_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/danmaku_search_title"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/danmaku_search_desc"
                    android:textColor="@color/white_50"
                    android:textSize="11sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/play_search"
                android:textColor="@color/white_70"
                android:textSize="12sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="#14FFFFFF" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/danmaku_auto_load"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/danmaku_auto_desc"
                    android:textColor="@color/white_50"
                    android:textSize="11sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/tabGroup"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabAppearance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/selector_control_sheet_button"
            android:gravity="center"
            android:text="@string/danmaku_section_display"
            android:textColor="@color/selector_control_sheet_text"
            android:textSize="14sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tabTiming"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/selector_control_sheet_button"
            android:gravity="center"
            android:text="@string/danmaku_section_timing"
            android:textColor="@color/selector_control_sheet_text"
            android:textSize="14sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 显示类型 / 同屏上限：对应 NewBox 面板的「显示类型」「同屏上限」两段 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/displayExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="24dp"
                    android:text="@string/danmaku_display_type"
                    android:textColor="@color/white_50"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/typeScroll"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_control_sheet_button"
                        android:gravity="center"
                        android:text="@string/danmaku_show_scroll"
                        android:textColor="@color/selector_control_sheet_text"
                        android:textSize="13sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/typeTop"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/selector_control_sheet_button"
                        android:gravity="center"
                        android:text="@string/danmaku_show_top"
                        android:textColor="@color/selector_control_sheet_text"
                        android:textSize="13sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/typeBottom"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/selector_control_sheet_button"
                        android:gravity="center"
                        android:text="@string/danmaku_show_bottom"
                        android:textColor="@color/selector_control_sheet_text"
                        android:textSize="13sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="24dp"
                    android:text="@string/danmaku_max_on_screen"
                    android:textColor="@color/white_50"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:overScrollMode="never"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:scrollbars="none">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/max10"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/selector_control_sheet_button"
                            android:gravity="center"
                            android:text="10"
                            android:textColor="@color/selector_control_sheet_text"
                            android:textSize="13sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/max20"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/selector_control_sheet_button"
                            android:gravity="center"
                            android:text="20"
                            android:textColor="@color/selector_control_sheet_text"
                            android:textSize="13sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/max30"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/selector_control_sheet_button"
                            android:gravity="center"
                            android:text="30"
                            android:textColor="@color/selector_control_sheet_text"
                            android:textSize="13sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/max50"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/selector_control_sheet_button"
                            android:gravity="center"
                            android:text="50"
                            android:textColor="@color/selector_control_sheet_text"
                            android:textSize="13sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/max80"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/selector_control_sheet_button"
                            android:gravity="center"
                            android:text="80"
                            android:textColor="@color/selector_control_sheet_text"
                            android:textSize="13sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/max120"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/selector_control_sheet_button"
                            android:gravity="center"
                            android:text="120"
                            android:textColor="@color/selector_control_sheet_text"
                            android:textSize="13sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/max150"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/selector_control_sheet_button"
                            android:gravity="center"
                            android:text="150"
                            android:textColor="@color/selector_control_sheet_text"
                            android:textSize="13sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/max200"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/selector_control_sheet_button"
                            android:gravity="center"
                            android:text="200"
                            android:textColor="@color/selector_control_sheet_text"
                            android:textSize="13sp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </HorizontalScrollView>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <include
                android:id="@+id/appearance"
                layout="@layout/view_danmaku_appearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible" />

            <include
                android:id="@+id/timing"
                layout="@layout/view_danmaku_timing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
