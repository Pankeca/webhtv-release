<?xml version="1.0" encoding="utf-8"?>
<!-- 底栏导航胶囊：和顶栏同一套玻璃质感胶囊，只是更大一号（38dp 高、14sp 字），选中变金色实心 -->
<com.google.android.material.textview.MaterialTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/selector_nav_pill"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_round_20"
    android:gravity="center"
    android:includeFontPadding="false"
    android:letterSpacing="0.03"
    android:maxLines="1"
    android:minWidth="92dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:textColor="@color/selector_nav_pill_text"
    android:textSize="14sp"
    android:textStyle="bold" />
