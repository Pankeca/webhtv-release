<?xml version="1.0" encoding="utf-8"?>
<!--
  缓存管理弹窗（对齐 TVBox）：当前缓存、自动清缓存开关、缓存上限、立即清理。
  尺寸由 LightDialog 统一按横竖屏比例给，文字都单行/自适应，四形态不压缩不截断。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cache_manager_title"
        android:textColor="#202124"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/cache_current_loading"
        android:textColor="#5F6368"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:background="#E5E7EB" />

    <!-- 自动清缓存：开启 / 关闭 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/autoRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cache_auto_clear"
            android:textColor="#202124"
            android:textSize="15sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/autoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textColor="#1A73E8"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="关闭" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 缓存上限：点击选择档位 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/limitRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cache_limit"
            android:textColor="#202124"
            android:textSize="15sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/limitValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textColor="#1A73E8"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="300 MB" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/limitHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/cache_limit_tip"
        android:textColor="#5F6368"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clear"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/cache_clear_now"
        android:textColor="@color/dialog_tonal_button_text"
        android:textSize="15sp"
        app:backgroundTint="@color/dialog_tonal_button_bg"
        app:cornerRadius="8dp" />

</androidx.appcompat.widget.LinearLayoutCompat>
