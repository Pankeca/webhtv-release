<?xml version="1.0" encoding="utf-8"?>
<!--
  顶栏「文字图标 + 胶囊文本框」。
  原来的五个图标（刷新/追更/历史/下载/我的）一律换成这一个小胶囊，文字由菜单 title 填进来，
  这样多语言只改 strings.xml，不用给每个按钮单独做一套图。

  间距：胶囊之间留 6dp（原来 3dp 挤在一起，看着像连体），高度 34dp、圆角 18dp 保证是完整胶囊，
  底用竖向渐变做玻璃质感，按压有 ripple。
-->
<com.google.android.material.textview.MaterialTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/shape_home_pill"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_round_20"
    android:gravity="center"
    android:includeFontPadding="false"
    android:letterSpacing="0.02"
    android:maxLines="1"
    android:minWidth="46dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:textColor="@color/white"
    android:textSize="12sp" />
