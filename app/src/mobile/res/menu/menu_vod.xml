<?xml version="1.0" encoding="utf-8"?>
<!--
  首页顶栏菜单。
  除搜索框外，所有入口一律用「文字图标 + 胶囊文本框」（app:actionLayout），不再放图标：
  文字由 android:title 提供，VodFragment 会把它填进 view_home_pill 里。
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/search"
        android:title="@string/menu_search"
        app:actionLayout="@layout/view_home_search"
        app:showAsAction="always" />

    <item
        android:id="@+id/refresh"
        android:title="@string/pill_refresh"
        app:actionLayout="@layout/view_home_pill"
        app:showAsAction="always" />

    <item
        android:id="@+id/keep"
        android:title="@string/pill_keep"
        app:actionLayout="@layout/view_home_pill"
        app:showAsAction="always" />

    <item
        android:id="@+id/history"
        android:title="@string/pill_history"
        app:actionLayout="@layout/view_home_pill"
        app:showAsAction="always" />

    <item
        android:id="@+id/download"
        android:title="@string/pill_download"
        app:actionLayout="@layout/view_home_pill"
        app:showAsAction="always" />

    <item
        android:id="@+id/web_home_fullscreen"
        android:icon="@drawable/ic_control_fullscreen"
        android:title="@string/play_fullscreen"
        android:visible="false"
        app:iconTint="@color/white"
        app:showAsAction="always" />

    <item
        android:id="@+id/account"
        android:title="@string/pill_mine"
        app:actionLayout="@layout/view_home_pill"
        app:showAsAction="always" />

</menu>
